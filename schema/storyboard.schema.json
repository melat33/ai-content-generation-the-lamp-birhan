{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["version", "title", "language", "style_block", "reference", "music", "shots"],
  "properties": {
    "version": {"type": "string"},
    "title": {"type": "string"},
    "author": {"type": "string"},
    "logline": {"type": "string"},
    "language": {"type": "string", "description": "BCP-47 narration language, e.g. am"},
    "subtitle_language": {"type": "string"},
    "style_block": {"type": "string", "minLength": 10, "description": "Appended to every image prompt"},
    "reference": {
      "type": "object",
      "required": ["symbol", "prompt", "seed"],
      "properties": {
        "symbol": {"type": "string"},
        "prompt": {"type": "string"},
        "seed": {"type": "integer"}
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "instrumental", "bpm", "key", "duration_s", "seed"],
      "properties": {
        "caption": {"type": "string"},
        "instrumental": {"type": "boolean"},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": "string"},
        "duration_s": {"type": "integer", "minimum": 30, "maximum": 120},
        "seed": {"type": "integer"}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "act", "duration_s", "shot_size", "reason", "image_prompt", "motion_prompt", "narration", "music_cue", "seed"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "act": {"enum": ["built", "fall", "question"]},
          "duration_s": {"type": "number", "minimum": 3, "maximum": 10},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "extreme_close"]},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists"},
          "image_prompt": {"type": "string", "minLength": 10},
          "motion_prompt": {"type": "string", "minLength": 5, "description": "Motion and camera only"},
          "narration": {
            "type": "object",
            "required": ["am", "en"],
            "properties": {"am": {"type": "string"}, "en": {"type": "string"}}
          },
          "music_cue": {"type": "string"},
          "seed": {"type": "integer"},
          "grade": {
            "type": "object",
            "properties": {"saturation": {"type": "number", "minimum": 0, "maximum": 2}}
          },
          "ambience": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {"enum": ["church_bell", "choir_drone", "kebero", "tsenatsel", "birds", "wind", "quill", "crowd", "plane", "flame", "room_tone", "latch", "footsteps"]},
                "gain_db": {"type": "number", "minimum": -60, "maximum": 6}
              }
            }
          }
        }
      }
    }
  }
}
